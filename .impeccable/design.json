  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "每個畫面唯一的主要動作（建立並開始錄音、結束會議、儲存、複製 Markdown）。",
      "html": "<button class=\"ds-btn ds-btn-primary\">結束會議</button>",
      "css": ".ds-btn{display:inline-flex;align-items:center;justify-content:center;gap:6px;min-height:32px;padding:5px 12px;border:1px solid var(--line);border-radius:8px;background:var(--fill-2);color:var(--ink);font-size:13.5px;line-height:1.3;white-space:nowrap;cursor:pointer;transition:background-color 120ms ease-out,border-color 120ms ease-out;} .ds-btn:hover{background:var(--hover);} .ds-btn:focus-visible{outline:2px solid var(--ring);outline-offset:2px;} .ds-btn-primary{border-color:transparent;background:var(--acc);color:var(--acc-ink);font-weight:600;} .ds-btn-primary:hover{background:var(--acc-hover);}"
    },
    {
      "name": "Default Button",
      "kind": "button",
      "refersTo": "button",
      "description": "一般動作：暫停、切段、繼續收音、複製等。",
      "html": "<button class=\"ds-btn\"><svg class=\"ds-icon\" viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M20 11a8 8 0 0 0-14.5-4.6L4 8\"/><path d=\"M4 4v4h4\"/></svg><span>繼續收音</span></button>",
      "css": ".ds-icon{width:16px;height:16px;flex:none;fill:none;stroke:currentColor;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round;} .ds-btn{display:inline-flex;align-items:center;justify-content:center;gap:6px;min-height:32px;padding:5px 12px;border:1px solid var(--line);border-radius:8px;background:var(--fill-2);color:var(--ink);font-size:13.5px;line-height:1.3;white-space:nowrap;cursor:pointer;transition:background-color 120ms ease-out,border-color 120ms ease-out;} .ds-btn:hover{background:var(--hover);} .ds-btn:focus-visible{outline:2px solid var(--ring);outline-offset:2px;}"
    },
    {
      "name": "Segmented Control",
      "kind": "custom",
      "refersTo": "segmented-control",
      "description": "「並排｜筆記｜逐字稿」版面切換與主題切換，仿系統分段控制。",
      "html": "<div class=\"ds-seg\" role=\"group\"><button class=\"on\">並排</button><button>筆記</button><button>逐字稿</button></div>",
      "css": ".ds-seg{display:inline-flex;gap:2px;padding:2px;border-radius:9px;background:var(--fill);} .ds-seg button{padding:3px 11px;border:0;border-radius:7px;background:transparent;color:var(--ink-2);font-size:13px;line-height:1.6;cursor:pointer;} .ds-seg button:hover:not(.on){color:var(--ink);} .ds-seg button.on{background:var(--raise);color:var(--ink);font-weight:600;box-shadow:0 1px 2px rgba(0,0,0,.14),0 0 0 .5px rgba(0,0,0,.04);} .ds-seg button:focus-visible{outline:2px solid var(--ring);outline-offset:2px;}"
    },
    {
      "name": "Note-kind Tags",
      "kind": "chip",
      "refersTo": "tag-decision",
      "description": "筆記類型膠囊：決議、待辦、待確認、想法、筆記。",
      "html": "<span class=\"ds-tag ds-k-decision\">決議</span> <span class=\"ds-tag ds-k-todo\">待辦</span> <span class=\"ds-tag ds-k-question\">待確認</span> <span class=\"ds-tag ds-k-idea\">想法</span> <span class=\"ds-tag ds-k-note\">筆記</span>",
      "css": ".ds-tag{display:inline-flex;align-items:center;height:22px;padding:0 9px;border-radius:999px;font-size:12px;font-weight:600;line-height:1;white-space:nowrap;} .ds-k-decision{background:var(--k-decision-bg);color:var(--k-decision);} .ds-k-todo{background:var(--k-todo-bg);color:var(--k-todo);} .ds-k-question{background:var(--k-question-bg);color:var(--k-question);} .ds-k-idea{background:var(--k-idea-bg);color:var(--k-idea);} .ds-k-note{background:var(--k-note-bg);color:var(--k-note);}"
    },
    {
      "name": "Sidebar Meeting List",
      "kind": "nav",
      "refersTo": "sidebar-row-selected",
      "description": "左側會議清單：分組小標、選中列用選取暖黃，錄音中標示錄音紅。",
      "html": "<nav class=\"ds-side\"><div class=\"ds-side-group\">今天</div><a class=\"ds-side-meeting on\" href=\"#\"><b>Q4 產品路線圖週會</b><span>17:08　已暫停</span></a><a class=\"ds-side-meeting\" href=\"#\"><b>客戶 A 需求訪談</b><span class=\"ds-live\">錄音中</span></a></nav>",
      "css": ".ds-side{width:240px;padding:12px 10px;background:var(--side);border-right:1px solid var(--line);} .ds-side-group{padding:14px 8px 4px;color:var(--mute);font-size:12px;font-weight:600;} .ds-side-meeting{display:block;padding:7px 10px;border-radius:8px;color:var(--ink);text-decoration:none;} .ds-side-meeting:hover{background:var(--hover);} .ds-side-meeting b{display:block;font-size:14px;font-weight:600;line-height:1.45;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;} .ds-side-meeting span{color:var(--mute);font-size:12px;} .ds-side-meeting.on{background:var(--sel);color:var(--sel-ink);} .ds-side-meeting.on span{color:inherit;opacity:.8;} .ds-side-meeting span.ds-live{color:var(--rec);font-weight:600;} .ds-live::before{content:\"\";display:inline-block;width:6px;height:6px;margin-right:4px;border-radius:50%;background:var(--rec);vertical-align:1px;} .ds-side-meeting:focus-visible{outline:2px solid var(--ring);outline-offset:2px;}"
    },
    {
      "name": "Composer",
      "kind": "input",
      "refersTo": "composer",
      "description": "錄音頁頁尾常駐的筆記輸入列，左側是目前類型膠囊。",
      "html": "<div class=\"ds-composer\"><span class=\"ds-tag\">筆記</span><input placeholder=\"寫下重點，Enter 送出\" /><button class=\"ds-btn\">送出</button></div>",
      "css": ".ds-tag{display:inline-flex;align-items:center;height:22px;padding:0 9px;border-radius:999px;font-size:12px;font-weight:600;line-height:1;white-space:nowrap;} .ds-btn{display:inline-flex;align-items:center;justify-content:center;gap:6px;min-height:32px;padding:5px 12px;border:1px solid var(--line);border-radius:8px;background:var(--fill-2);color:var(--ink);font-size:13.5px;line-height:1.3;white-space:nowrap;cursor:pointer;transition:background-color 120ms ease-out,border-color 120ms ease-out;} .ds-btn:hover{background:var(--hover);} .ds-btn:focus-visible{outline:2px solid var(--ring);outline-offset:2px;} .ds-composer{display:flex;align-items:center;gap:10px;max-width:680px;padding:6px 6px 6px 10px;border:1px solid var(--line-strong);border-radius:12px;background:var(--fill-2);} .ds-composer:focus-within{border-color:var(--ring);box-shadow:0 0 0 1px var(--ring);} .ds-composer input{flex:1;min-width:0;min-height:34px;padding:0;border:0;background:transparent;color:var(--ink);font:inherit;font-size:15px;outline:none;} .ds-composer input::placeholder{color:var(--mute);} .ds-composer .ds-tag{background:var(--k-note-bg);color:var(--k-note);}"
    },
    {
      "name": "Text Input",
      "kind": "input",
      "refersTo": "input",
      "description": "設定頁與表單的文字欄位、下拉選單。",
      "html": "<input class=\"ds-input\" type=\"text\" placeholder=\"API key\" />",
      "css": ".ds-input{min-height:34px;padding:6px 10px;border:1px solid var(--line-strong);border-radius:8px;background:var(--bg);color:var(--ink);font-size:14px;} .ds-input::placeholder{color:var(--mute);} .ds-input:focus-visible{outline:2px solid var(--ring);outline-offset:0;border-color:transparent;}"
    },
    {
      "name": "Settings Group",
      "kind": "card",
      "refersTo": "settings-group",
      "description": "設定頁的群組：左標籤右控制項，列間 1px 細線。",
      "html": "<div class=\"ds-group\"><div class=\"ds-r\"><div><div class=\"ds-r-label\">轉錄引擎</div><small>切段後送出音訊</small></div><div class=\"ds-r-ctl\">Gemini</div></div><div class=\"ds-r\"><div><div class=\"ds-r-label\">每段長度</div></div><div class=\"ds-r-ctl\">5 分鐘</div></div></div>",
      "css": ".ds-group{border:1px solid var(--line);border-radius:12px;background:var(--fill-2);} .ds-r{display:grid;grid-template-columns:minmax(150px,36%) minmax(0,1fr);align-items:center;gap:8px 16px;min-height:54px;padding:11px 16px;} .ds-r+.ds-r{border-top:1px solid var(--line);} .ds-r-label{font-size:14px;font-weight:500;color:var(--ink);} .ds-r small{display:block;margin-top:2px;color:var(--mute);font-size:12.5px;} .ds-r-ctl{display:flex;justify-content:flex-end;color:var(--ink-2);font-size:14px;}"
    },
    {
      "name": "Editable Title",
      "kind": "custom",
      "refersTo": "typography.headline",
      "description": "可就地編輯的會議標題：平常是文字，hover 露出細線框，聚焦轉焦點琥珀。",
      "html": "<div class=\"ds-date\">2026 年 11 月 24 日 17:08</div><h1 class=\"ds-title\" tabindex=\"0\">Q4 產品路線圖週會</h1>",
      "css": ".ds-date{color:var(--mute);font-size:13px;font-variant-numeric:tabular-nums;} .ds-title{margin:2px 0 0 -8px;padding:2px 8px;border:1px solid transparent;border-radius:8px;font-size:28px;font-weight:700;line-height:1.3;color:var(--ink);cursor:text;} .ds-title:hover{border-color:var(--line);} .ds-title:focus-visible{outline:none;border-color:var(--ring);background:var(--bg);}"
    },
    {
      "name": "Toast",
      "kind": "custom",
      "refersTo": "toast",
      "description": "右下角提示框，浮層陰影；錯誤版本用危險淡底。",
      "html": "<div class=\"ds-toast\">已複製 Markdown</div> <div class=\"ds-toast ds-toast-error\">轉錄失敗：額度用完，明天再試或換引擎</div>",
      "css": ".ds-toast{display:inline-block;max-width:440px;padding:10px 14px;border:1px solid var(--line);border-radius:10px;background:var(--raise);color:var(--ink);font-size:14px;line-height:1.6;box-shadow:var(--shadow);animation:ds-toast-in 140ms ease-out;} .ds-toast-error{border-color:color-mix(in srgb,var(--danger) 45%,var(--line));background:var(--danger-bg);} @keyframes ds-toast-in{from{opacity:0;transform:translateY(6px);}}"
    }
  ],
  "narrative": {
    "northStar": "作業系統內建的筆記本",
    "overview": "會議助手長得像作業系統自帶的筆記 App，而不是一個 AI 產品：左側灰色側欄是會議清單，中央白紙是人自己的筆記（人的判斷是主角），右側是可以拖曳調寬的逐字稿素材欄。整套介面用系統字體、1px 細線、8–12px 的圓角和兩種主題下各自調好的中性灰，安靜到開會時一瞥就懂，眼睛可以留在會議本身。\n\n色彩只在有意義的地方出現：黃色是「你的下一步」與「你選中的那場會議」，紅色只代表「正在錄」，筆記類型（決議、待辦、待確認、想法、筆記）各有一組淡底深字的膠囊色。其餘一切都是灰階與細線。資訊密度維持在工具等級：13–16px 的內文、32px 高的控制項、工具列 56px，不靠大留白或大字製造氣氛。\n\n已確認拒絕的方向：白底卡片＋藍色主按鈕的 SaaS 儀表板、首頁會議卡片牆。",
    "keyCharacteristics": [
      "三欄外殼：灰側欄＋中央 680–720px 版心＋可拖寬窄的側欄（逐字稿／對照素材）。",
      "淺色白底配 #f5f5f7 側欄；深色 #1c1c1e 配 #232325 側欄，兩種主題共用同一套變數名稱。",
      "黃色只給一個主要動作與選取中的會議，紅色只給錄音中。",
      "五色筆記類型膠囊，深淺兩組各自調色。",
      "系統字體、1px 分隔線、8–12px 圓角、主題化細捲軸、平面無陰影。",
      "動態只用在狀態切換（120–160ms），錄音中沒有持續動畫；`prefers-reduced-motion` 時全部歸零。"
    ],
    "rules": [
      {
        "name": "The One Yellow Voice Rule",
        "body": "每個畫面只有一個黃色按鈕。黃色是「下一步」與「你選中的」，不是裝飾、不是區塊底色、不是連結色；新的小狀態要用黃色，必須同樣是「輪到你處理」的意思。",
        "section": "colors"
      },
      {
        "name": "The Red Means Live Rule",
        "body": "紅色（`rec`）只表示此刻正在錄音。錯誤與刪除用 `danger`，不借用錄音紅；暫停中的錄音點改為黃色。",
        "section": "colors"
      },
      {
        "name": "The Same Names Rule",
        "body": "每個主題變數都同時在淺色與深色區塊宣告，元件只寫 `var(--name)`，不寫死任一主題的色碼；少數例外（開關圓鈕白色、截圖移除鈕的半透明黑）只出現在兩種主題下都成立的地方。",
        "section": "colors"
      },
      {
        "name": "The System Voice Rule",
        "body": "只用系統字體堆疊，不載入任何外部字型；字級變化不超過 13–28px 這個工具級距。",
        "section": "typography"
      },
      {
        "name": "The Tabular Time Rule",
        "body": "計時器、時間戳、段落編號、日期行一律 `font-variant-numeric: tabular-nums`，數字跳動時不晃動版面。",
        "section": "typography"
      },
      {
        "name": "The Flat Paper Rule",
        "body": "卡片、列表、窗格、設定群組都不帶陰影；只有選單、提示框、抽屜這類暫時浮在上面的東西才用 `--shadow`。",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** 所有顏色都寫 `var(--name)`，新增顏色時同時在淺色與深色兩個區塊宣告同名變數。",
      "**Do** 每個畫面只放一個黃色主要動作按鈕（`acc`），其餘按鈕用 `fill-2` 預設樣式。",
      "**Do** 區塊之間用 1px `line` 細線分隔，圓角留在 6–12px 與 999px 全圓膠囊兩種語彙內。",
      "**Do** 時間、計時、段號、日期使用 `font-variant-numeric: tabular-nums`。",
      "**Do** 圖示使用 `src/ui/icons.ts` 的 24 格、1.8 線寬、圓角端點、`currentColor` 線條 SVG。",
      "**Do** 狀態過渡限制在 120–160ms ease-out，並讓 `prefers-reduced-motion: reduce` 把過渡與動畫歸零。",
      "**Do** 可就地編輯的文字平常看起來就是內文，hover 露出 1px 邊框、聚焦轉 `ring`。",
      "**Do** 主題預設跟隨系統，手動選擇存在 localStorage `meeting-assistant.theme`，並在第一次繪製前由 index.html 套上 `data-theme`。"
    ],
    "donts": [
      "**Don't** 做成白底卡片＋藍色主按鈕的 SaaS 儀表板，也不要把會議做成首頁卡片牆。",
      "**Don't** 用錄音紅（`rec`）表示錄音以外的任何狀態；錯誤與刪除用 `danger`。",
      "**Don't** 把黃色當裝飾、區塊底色或第二個主要按鈕。",
      "**Don't** 用 Unicode 符號或 emoji 充當圖示。",
      "**Don't** 給卡片、列表、設定群組加陰影；陰影只屬於選單、提示框與抽屜。",
      "**Don't** 載入外部字型或其他外部資源。",
      "**Don't** 在錄音中加入持續播放的動畫。"
    ]
  }
}
