      },
      "title": {
        "displayName": "Title",
        "purpose": "會議紀錄 Markdown h2（18px／700）；h1 22px、h3 15.5px／600。"
      },
      "note": {
        "displayName": "Note",
        "purpose": "中央筆記內文；會議紀錄本文 16px／1.85。"
      },
      "body": {
        "displayName": "Body",
        "purpose": "全站基準字級與頁尾輸入框。"
      },
      "transcript": {
        "displayName": "Transcript",
        "purpose": "逐字稿段落；逐字稿版面放大為 17px／1.85。"
      },
      "control": {
        "displayName": "Control",
        "purpose": "按鈕、下拉選單。"
      },
      "label": {
        "displayName": "Label",
        "purpose": "環節小標、群組標題、欄位標籤、段落標頭。"
      },
      "caption": {
        "displayName": "Caption",
        "purpose": "時間戳、說明、提示、legend（12–12.5px）。"
      },
      "pill": {
        "displayName": "Pill",
        "purpose": "筆記類型膠囊與狀態膠囊。"
      },
      "mono": {
        "displayName": "Mono",
        "purpose": "code、kbd、指令提示。"
      }
    },
    "shadows": [
