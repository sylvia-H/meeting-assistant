# 複製為 .env 後填入，或直接在 app 的「設定」頁填（設定頁的值優先）
# Typeless（付費）：https://docs.typelessapi.com
TYPELESS_API_KEY=tls_sk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Gemini：轉錄與摘要可共用同一把 key（有免費額度）：https://aistudio.google.com/apikey
GEMINI_API_KEY=

# 摘要用的其他 LLM（三家擇一，app 內可切換）
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# 選用：改預設資料夾、連接埠、Gemini 轉錄模型
# MEETINGS_DIR=meetings
# PORT=8787
# GEMINI_TRANSCRIBE_MODEL=gemini-2.5-flash
