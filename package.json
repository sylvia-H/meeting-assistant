{
  "name": "meeting-assistant",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "本機執行的會議助手：邊開會邊錄音轉逐字稿、邊打字做筆記，會後用 LLM 產出 markdown 會議紀錄。可打包成單一 Windows exe。",
  "scripts": {
    "dev": "node scripts/dev.ts",
    "build": "tsc --noEmit && vite build",
    "start": "node server/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"src/**/*.test.ts\" \"server/**/*.test.ts\"",
    "smoke": "node scripts/smoke.ts && node scripts/smoke-setup.ts",
    "smoke:exe": "node scripts/smoke.ts --exe",
    "package": "node scripts/package.ts",
    "e2e": "node scripts/e2e.ts",
    "typography": "node scripts/typography.ts",
    "preview": "node scripts/preview.ts"
  },
  "dependencies": {
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/ws": "^8.18.1",
    "rolldown": "^1.2.19",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
